# Local SQL Server container used for the vitest/supertest integration suite
# and for load testing — kept separate from .env (which may point at the
# shared Azure SQL dev DB) so tests never touch real demo/testing data.
#
# Start the container:
#   docker run -e "ACCEPT_EULA=Y" -e "MSSQL_SA_PASSWORD=<your-password>" \
#     -p 1433:1433 --name carecompetencies-sql-test \
#     -v carecompetencies-sql-test-data:/var/opt/mssql \
#     -d mcr.microsoft.com/mssql/server:2022-latest
#
# Then, with this file copied to .env.test (gitignored) and your password filled
# in below, run (from api/, with these vars exported or DB_SERVER=localhost etc.
# prefixed): `npm run db:setup && npm run seed` — db:setup creates the database
# itself on a fresh container, then applies schema.sql.

JWT_SECRET=test-secret-not-used-in-production
FRONTEND_ORIGIN=http://localhost:5173
DEV_PASSWORD=duke24

DB_SERVER=localhost
DB_PORT=1433
DB_NAME=CareCompetencies
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
