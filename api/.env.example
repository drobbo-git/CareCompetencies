# Secret used to sign JWTs — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# API port (Railway sets PORT automatically)
PORT=3001

# Origin of the frontend (used for CORS)
# In development: http://localhost:5173
# In production:  https://your-app.vercel.app
FRONTEND_ORIGIN=http://localhost:5173

# Vars for MSSQL Server

DB_SERVER=localhost
DB_PORT=1433
DB_NAME=CareCompetencies
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
